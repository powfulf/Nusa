# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Database (read by the postgres container and used to build the connection
# string for the application)
# ---------------------------------------------------------------------------

# Required. There is no default, on purpose: a default password is a password
# every deployment shares.
POSTGRES_PASSWORD=change-me-before-you-deploy-anything

POSTGRES_USER=nusa
POSTGRES_DB=nusa

# Host port for Postgres, bound to 127.0.0.1. Change it if 5432 is taken.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Host port the app is published on.
NUSA_HTTP_PORT=8080

# development | production.
#
# Affects operational defaults — development logs plain text, production logs
# JSON — and one security setting: in production, session cookies carry the
# Secure attribute and there is no variable that turns that off. Development
# leaves it off so that signing in over http://localhost works.
NUSA_ENV=development

# debug | info | warn | error
NUSA_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Read directly by the binary when you run it outside Compose
# (`make dev`, `make migrate-up`). Compose builds this value itself.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string.
NUSA_DATABASE_URL=postgres://nusa:change-me-before-you-deploy-anything@localhost:5432/nusa?sslmode=disable

# Listen address for the HTTP server.
# NUSA_HTTP_ADDR=:8080

# Directory holding the built frontend. When it does not exist the server runs
# API-only, which is what you want while Vite serves the app in development.
# NUSA_WEB_DIR=web/dist

# How long in-flight requests may finish after a termination signal.
# NUSA_SHUTDOWN_TIMEOUT=15s

# How long the health endpoint waits for the database before reporting failure.
# NUSA_HEALTH_TIMEOUT=2s

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# How long a session lasts before it must be repeated, regardless of activity.
# NUSA_SESSION_TTL=720h

# Failed sign-in attempts allowed per client address, and the span they are
# counted over. Failures only — a successful sign-in clears the count — and the
# account is deliberately not part of the key, so nobody can lock somebody else
# out by guessing at their address. See internal/auth/ratelimit.go.
# NUSA_LOGIN_FAILURE_LIMIT=10
# NUSA_LOGIN_FAILURE_WINDOW=15m

# Networks whose X-Forwarded-For header may be believed, comma separated.
#
# Empty — the default — means the header is ignored entirely and every request
# is attributed to the address it actually arrived from. That is correct when
# nothing sits in front of Nusa, and it is the only safe default: a client can
# put anything in that header, so believing it from an unknown source lets
# anyone claim to be anyone.
#
# Set this only to the addresses of proxies you run. Entries must be exact:
# a range with host bits set (10.0.0.1/24) is refused rather than guessed at,
# and 0.0.0.0/0 is refused outright because it would trust every client to
# state its own address.
#
# NUSA_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5

# ---------------------------------------------------------------------------
# Password hashing (Argon2id)
# ---------------------------------------------------------------------------

# These may be RAISED above the defaults and never lowered. The defaults were
# derived from the weakest host Nusa targets — see auth.DefaultParams — so
# there is no deployment that legitimately needs less, and a cost that can be
# turned down is a cost that eventually gets turned down to nothing.
#
# Raising memory is the strongest change; raising iterations costs time without
# costing memory, which is the lever to reach for on a machine that is fast but
# short of RAM.
#
# NUSA_ARGON2_MEMORY_KIB=19456
# NUSA_ARGON2_ITERATIONS=2
# NUSA_ARGON2_PARALLELISM=1
